{
  "name": "world-express",
  "version": "0.47.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "ci": "npm run lint && npm run typecheck && npm run depcruise && npm run test && npm run build",
    "graph": "node scripts/generate-dependency-graph.mjs",
    "graph:check": "node scripts/generate-dependency-graph.mjs --check",
    "art:check": "node scripts/check-city-backgrounds.mjs",
    "shot": "node scripts/shot.mjs",
    "check": "npm run ci && npm run graph:check && npm run art:check && npm run test:e2e",
    "preview": "node scripts/preview-animation.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
